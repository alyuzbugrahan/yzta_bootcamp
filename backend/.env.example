# Local development defaults
AGROVISION_MODEL__ALLOW_DEMO=1
AGROVISION_LOG_JSON=0
AGROVISION_DATABASE__URL=sqlite+aiosqlite:///./agrovision.db
AGROVISION_STORAGE__BACKEND=local
AGROVISION_STORAGE__ROOT=data/images

# Add a real model when available, then set ALLOW_DEMO=0
# AGROVISION_MODEL__PATH=models/final_model.pt
# AGROVISION_MODEL__ALLOW_DEMO=0

# RAG assets are bundled under backend/rag_assets.
AGROVISION_RAG__ENABLED=1
AGROVISION_RAG__VECTOR_STORE_PATH=rag_assets/incir_vektor_deposu_v2
AGROVISION_RAG__SOURCES_PATH=rag_assets/veri_havuzu
AGROVISION_RAG__LLM_MODEL=gemini-3.5-flash

# Optional: without a key, the assistant returns extractive source-based answers.
# Prefer AGROVISION_RAG__API_KEY; GOOGLE_API_KEY is also supported for compatibility.
AGROVISION_RAG__API_KEY=
